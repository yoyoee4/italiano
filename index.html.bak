<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#0d1117">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>BellaLingua — ללמוד איטלקית</title>
<style>
:root{
  --bg1:#0d1117;--bg2:#161b22;--bg3:#21262d;--bg4:#30363d;
  --text:#e6edf3;--text2:#8b949e;--accent:#00d4aa;--accent2:#00b894;
  --danger:#ff4757;--warning:#ffa502;--success:#2ed573;
  --border:#21262d;--radius:12px;--radius-sm:8px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:system-ui,-apple-system,sans-serif;background:linear-gradient(135deg,var(--bg1),var(--bg2));color:var(--text);min-height:100vh;overflow-x:hidden;-webkit-tap-highlight-color:transparent}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg1)}
::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:3px}

/* Top Bar */
.topbar{position:fixed;top:0;left:0;right:0;height:56px;background:var(--bg1);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 16px;z-index:100}
.topbar-title{font-size:18px;font-weight:700;display:flex;align-items:center;gap:8px}
.topbar-title span:first-child{font-size:24px}
.hearts-display{display:flex;gap:2px;font-size:16px}
.heart{transition:all .3s}.heart.lost{opacity:.3;filter:grayscale(1)}
.heart.shake{animation:heartShake .4s}
@keyframes heartShake{0%,100%{transform:scale(1)}25%{transform:scale(1.3)}50%{transform:scale(.8)}75%{transform:scale(1.1)}}
.xp-badge{background:linear-gradient(135deg,var(--accent),var(--accent2));color:var(--bg1);padding:2px 10px;border-radius:20px;font-weight:700;font-size:13px}

/* Bottom Nav */
.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:64px;background:var(--bg1);border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-around;z-index:100;padding-bottom:env(safe-area-inset-bottom)}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 12px;cursor:pointer;transition:all .2s;position:relative;min-width:56px;border:none;background:none;color:var(--text2);font-size:10px}
.nav-item.active{color:var(--accent)}
.nav-item.active::after{content:'';position:absolute;top:-1px;left:50%;transform:translateX(-50%);width:24px;height:3px;background:var(--accent);border-radius:0 0 3px 3px}
.nav-item .nav-icon{font-size:22px;line-height:1}
.nav-item .nav-label{font-size:10px;font-weight:600}

/* Pages */
.page{display:none;padding:64px 16px 80px;min-height:100vh;animation:fadeIn .2s}
.page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* Cards */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin:8px 0;transition:all .2s}
.card:hover,.card:active{border-color:var(--accent)}
.card-title{font-size:16px;font-weight:600;margin-bottom:8px;display:flex;align-items:center;gap:8px}
.card-desc{font-size:13px;color:var(--text2);line-height:1.5}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px;border-radius:var(--radius-sm);border:none;font-size:15px;font-weight:600;cursor:pointer;transition:all .2s;min-height:44px;font-family:inherit}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:var(--bg1)}
.btn-primary:active{transform:scale(.97);filter:brightness(1.1)}
.btn-secondary{background:var(--bg3);color:var(--text);border:1px solid var(--border)}
.btn-secondary:hover{border-color:var(--accent);color:var(--accent)}
.btn-danger{background:var(--danger);color:#fff}
.btn-sm{padding:8px 14px;font-size:13px;min-height:36px}
.btn-block{width:100%;justify-content:center}

/* Stats */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 0}
.stat-box{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 8px;text-align:center}
.stat-val{font-size:22px;font-weight:700;color:var(--accent)}
.stat-label{font-size:11px;color:var(--text2);margin-top:2px}

/* Progress Bar */
.progress-bar{height:8px;background:var(--bg3);border-radius:4px;overflow:hidden;margin:8px 0}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:4px;transition:width .5s ease}

/* Category Grid */
.cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}
.cat-item{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 8px;text-align:center;cursor:pointer;transition:all .2s;min-height:70px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}
.cat-item:active{transform:scale(.95);border-color:var(--accent)}
.cat-icon{font-size:24px}
.cat-name{font-size:11px;font-weight:600;color:var(--text)}
.cat-count{font-size:10px;color:var(--text2)}

/* Word List */
.word-item{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border)}
.word-item:last-child{border:none}
.word-it{font-size:16px;font-weight:600}
.word-he{font-size:13px;color:var(--text2)}
.word-left{flex:1}
.word-right{display:flex;align-items:center;gap:8px}
.speak-btn{width:36px;height:36px;border-radius:50%;background:var(--bg3);border:1px solid var(--border);color:var(--accent);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s}
.speak-btn:active{transform:scale(.9);background:var(--accent);color:var(--bg1)}
.learned-badge{background:var(--accent);color:var(--bg1);font-size:10px;padding:2px 6px;border-radius:10px;font-weight:600}

/* Quiz */
.quiz-option{padding:14px 16px;background:var(--bg2);border:2px solid var(--border);border-radius:var(--radius-sm);margin:8px 0;cursor:pointer;transition:all .2s;font-size:15px;text-align:center;min-height:48px;display:flex;align-items:center;justify-content:center}
.quiz-option:active{transform:scale(.97)}
.quiz-option.correct{border-color:var(--success);background:rgba(46,213,115,.15);color:var(--success);animation:popIn .3s}
.quiz-option.wrong{border-color:var(--danger);background:rgba(255,71,87,.15);color:var(--danger);animation:shake .4s}
.quiz-option.disabled{pointer-events:none;opacity:.6}
.quiz-option.reveal{border-color:var(--success);background:rgba(46,213,115,.1)}
@keyframes popIn{0%{transform:scale(1)}50%{transform:scale(1.05)}100%{transform:scale(1)}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}

/* Combo */
.combo-display{text-align:center;font-size:20px;font-weight:800;margin:8px 0;animation:comboPulse .3s}
.combo-x{color:var(--accent);font-size:28px}
@keyframes comboPulse{0%{transform:scale(1)}50%{transform:scale(1.3)}100%{transform:scale(1)}}

/* Anki Card */
.anki-card{background:var(--bg2);border:2px solid var(--border);border-radius:16px;padding:32px 20px;margin:16px 0;min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:all .3s;position:relative;overflow:hidden}
.anki-card:active{transform:scale(.98)}
.anki-card.revealed{border-color:var(--accent)}
.anki-front{font-size:28px;font-weight:700;text-align:center;line-height:1.4}
.anki-back{font-size:20px;color:var(--text2);text-align:center;margin-top:16px;opacity:0;transition:all .3s;transform:translateY(10px)}
.anki-card.revealed .anki-back{opacity:1;transform:translateY(0)}
.anki-cat{position:absolute;top:12px;left:12px;font-size:11px;background:var(--bg3);padding:4px 10px;border-radius:10px;color:var(--text2)}
.anki-buttons{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:16px}
.anki-btn{padding:12px 8px;border-radius:var(--radius-sm);border:none;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;display:flex;flex-direction:column;align-items:center;gap:4px;min-height:60px}
.anki-btn:active{transform:scale(.95)}
.anki-btn-forgot{background:rgba(255,71,87,.2);color:var(--danger)}
.anki-btn-hard{background:rgba(255,165,2,.2);color:var(--warning)}
.anki-btn-good{background:rgba(0,212,170,.2);color:var(--accent)}
.anki-btn-easy{background:rgba(46,213,115,.2);color:var(--success)}
.anki-btn-time{font-size:10px;opacity:.8}

/* Sentence Practice */
.sentence-card{background:var(--bg2);border:2px solid var(--border);border-radius:16px;padding:24px;margin:12px 0;text-align:center}
.sentence-it{font-size:24px;font-weight:700;margin:16px 0;line-height:1.4}
.sentence-he{font-size:16px;color:var(--text2);margin:8px 0}
.sentence-actions{display:flex;justify-content:center;gap:16px;margin:16px 0}
.mic-btn{width:64px;height:64px;border-radius:50%;border:3px solid var(--accent);background:transparent;color:var(--accent);font-size:28px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center}
.mic-btn.listening{background:var(--accent);color:var(--bg1);animation:micPulse 1s infinite}
@keyframes micPulse{0%,100%{box-shadow:0 0 0 0 rgba(0,212,170,.4)}50%{box-shadow:0 0 0 20px rgba(0,212,170,0)}}
.sentence-result{padding:12px;border-radius:var(--radius-sm);margin:12px 0;font-weight:600;font-size:15px}
.result-perfect{background:rgba(46,213,115,.15);color:var(--success);border:1px solid var(--success)}
.result-good{background:rgba(0,212,170,.15);color:var(--accent);border:1px solid var(--accent)}
.result-ok{background:rgba(255,165,2,.15);color:var(--warning);border:1px solid var(--warning)}
.result-retry{background:rgba(255,71,87,.15);color:var(--danger);border:1px solid var(--danger)}
.sentence-heard{font-size:14px;color:var(--text2);margin:8px 0}

/* Dialogue */
.dialogue-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin:8px 0;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:12px}
.dialogue-card:active{transform:scale(.98);border-color:var(--accent)}
.dialogue-icon{font-size:36px;width:50px;text-align:center}
.dialogue-info{flex:1}
.dialogue-title{font-size:16px;font-weight:600}
.dialogue-desc{font-size:12px;color:var(--text2)}
.dialogue-level{font-size:11px;background:var(--bg3);padding:2px 8px;border-radius:10px;align-self:flex-start}
.dlg-line{padding:12px;margin:6px 0;border-radius:var(--radius-sm);position:relative}
.dlg-npc{background:var(--bg3);margin-left:40px}
.dlg-you{background:rgba(0,212,170,.1);border:1px solid rgba(0,212,170,.3);margin-right:40px}
.dlg-role{font-size:11px;color:var(--accent);font-weight:600;margin-bottom:4px}
.dlg-text-it{font-size:17px;font-weight:500;line-height:1.4}
.dlg-text-he{font-size:13px;color:var(--text2);margin-top:4px}
.dlg-hint{font-size:13px;color:var(--warning);font-style:italic;margin-top:4px}
.dlg-input-area{background:var(--bg2);border:2px solid var(--border);border-radius:16px;padding:20px;margin:16px 0;text-align:center}
.dlg-progress{display:flex;gap:4px;margin:8px 0}
.dlg-dot{width:100%;height:4px;background:var(--bg3);border-radius:2px;transition:all .3s}
.dlg-dot.done{background:var(--accent)}
.dlg-dot.current{background:var(--warning);animation:dlgDotPulse 1s infinite}
@keyframes dlgDotPulse{0%,100%{opacity:1}50%{opacity:.4}}

/* Achievement Badge */
.badge{display:inline-flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:20px;padding:6px 12px;font-size:12px;margin:4px}
.badge.earned{background:rgba(0,212,170,.15);border-color:var(--accent);color:var(--accent)}

/* Toast */
.toast{position:fixed;top:70px;left:50%;transform:translateX(-50%) translateY(-20px);background:var(--bg3);border:1px solid var(--border);padding:10px 20px;border-radius:20px;font-size:14px;font-weight:600;z-index:200;opacity:0;transition:all .3s;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.success{border-color:var(--accent);color:var(--accent)}
.toast.error{border-color:var(--danger);color:var(--danger)}

/* XP Float */
.xp-float{position:fixed;pointer-events:none;font-size:18px;font-weight:800;color:var(--accent);z-index:300;animation:xpFloat 1s forwards}
@keyframes xpFloat{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-60px) scale(1.5)}}

/* Level Badge */
.level-badge{display:inline-flex;align-items:center;gap:6px;background:var(--bg3);padding:6px 14px;border-radius:20px;font-size:14px;font-weight:600}

/* Section Title */
.section-title{font-size:18px;font-weight:700;margin:16px 0 8px;display:flex;align-items:center;gap:8px}

/* Empty State */
.empty-state{text-align:center;padding:40px 20px;color:var(--text2)}
.empty-icon{font-size:48px;margin-bottom:12px}
.empty-text{font-size:16px;font-weight:600;margin-bottom:8px}
.empty-sub{font-size:13px}

/* Back Button */
.back-btn{display:flex;align-items:center;gap:6px;padding:8px 0;color:var(--accent);font-size:14px;font-weight:600;cursor:pointer;background:none;border:none;font-family:inherit}
</style>
</head><body>
<script src="data.js"></script>

<!-- Toast -->
<div class="toast" id="toast"></div>

<!-- Top Bar -->
<div class="topbar">
  <div class="topbar-title"><span>🇮🇹</span><span>BellaLingua</span></div>
  <div style="display:flex;align-items:center;gap:12px">
    <div class="hearts-display" id="heartsDisplay"></div>
    <div class="xp-badge" id="xpBadge">0 XP</div>
  </div>
</div>

<!-- ═══ PAGE: HOME ═══ -->
<div class="page active" id="page-home">
  <div style="text-align:center;margin:8px 0 16px">
    <div style="font-size:48px">🇮🇹</div>
    <h1 style="font-size:24px;margin:4px 0">BellaLingua</h1>
    <p style="color:var(--text2);font-size:14px">ללמוד איטלקית — בכיף! 🎉</p>
  </div>
  <div class="stats-row" id="homeStats"></div>
  <div id="homeLevelBar" class="card" style="margin-top:4px"></div>
  <div id="homeContinue"></div>
  <div id="homeAnkiDue"></div>
  <div id="homeDailyGoal"></div>
</div>

<!-- ═══ PAGE: LEARN ═══ -->
<div class="page" id="page-learn">
  <div id="learnContent"></div>
</div>

<!-- ═══ PAGE: PRACTICE ═══ -->
<div class="page" id="page-practice">
  <div id="practiceContent"></div>
</div>

<!-- ═══ PAGE: DIALOGUES ═══ -->
<div class="page" id="page-dialogues">
  <div id="dialoguesContent"></div>
</div>

<!-- ═══ PAGE: PROFILE ═══ -->
<div class="page" id="page-profile">
  <div id="profileContent"></div>
</div>

<!-- Bottom Nav -->
<div class="bottom-nav">
  <button class="nav-item active" data-page="home" onclick="goPage('home')">
    <span class="nav-icon">🏠</span><span class="nav-label">ראשי</span>
  </button>
  <button class="nav-item" data-page="learn" onclick="goPage('learn')">
    <span class="nav-icon">📖</span><span class="nav-label">למידה</span>
  </button>
  <button class="nav-item" data-page="practice" onclick="goPage('practice')">
    <span class="nav-icon">🎯</span><span class="nav-label">תרגול</span>
  </button>
  <button class="nav-item" data-page="dialogues" onclick="goPage('dialogues')">
    <span class="nav-icon">🗣️</span><span class="nav-label">שיחות</span>
  </button>
  <button class="nav-item" data-page="profile" onclick="goPage('profile')">
    <span class="nav-icon">👤</span><span class="nav-label">פרופיל</span>
  </button>
</div>

<script>
// ═══════════════════════════════════════
// STATE MANAGEMENT
// ═══════════════════════════════════════
const DEFAULT_STATE = {
  xp: 0, score: 0, wordsLearned: [], streak: 0, lastDay: '',
  character: 'marco', quizHistory: [], dailyGoal: 10, dailyDone: 0, dailyDate: '',
  sentencesPracticed: {}, dialoguesCompleted: {}, achievements: [],
  speechRate: 0.8, lastCategory: ''
};

let state, anki, quiz = {questions:[],current:0,score:0,type:'mixed',combo:0};
let currentAnki = null, ankiQueue = [];
let currentSentence = null, sentenceCat = null;
let currentDialogue = null, dlgLine = 0, dlgScore = 0;
let isListening = false, recognition = null;

function loadState(){
  try{ state = JSON.parse(localStorage.getItem('bellaState')) || {...DEFAULT_STATE}; }catch(e){ state = {...DEFAULT_STATE}; }
  // Fill defaults
  for(let k in DEFAULT_STATE) if(!(k in state)) state[k] = DEFAULT_STATE[k];
}
function loadAnki(){
  try{ anki = JSON.parse(localStorage.getItem('bellaAnki')) || {}; }catch(e){ anki = {}; }
}
function save(){ localStorage.setItem('bellaState', JSON.stringify(state)); }
function saveAnki(){ localStorage.setItem('bellaAnki', JSON.stringify(anki)); }

loadState(); loadAnki();

// ═══════════════════════════════════════
// LEVELS & XP
// ═══════════════════════════════════════
const XP_LEVELS = [0, 100, 300, 700, 1500, 3000, 5000, 8000, 12000];
const LEVEL_NAMES = ['🌱 מתחיל','🌿 יסודי','🌳 בינוני','🌺 מתקדם','🌟 שולט','💎 מומחה','👑 מאסטר','⚔️ סמוראי','🧿 אל'];
function getLevel(xp){
  for(let i=XP_LEVELS.length-1;i>=0;i--) if(xp>=XP_LEVELS[i]) return i;
  return 0;
}
function getLevelName(xp){ return LEVEL_NAMES[getLevel(xp)]; }
function getLevelProgress(xp){
  const lv = getLevel(xp), cur = xp - XP_LEVELS[lv], next = XP_LEVELS[lv+1] - XP_LEVELS[lv];
  return next > 0 ? Math.round(cur/next*100) : 100;
}

// ═══════════════════════════════════════
// HEARTS
// ═══════════════════════════════════════
function getHearts(){
  const h = JSON.parse(localStorage.getItem('bellaHearts') || '{"count":5,"regenAt":0}');
  if(h.count < 5 && Date.now() > h.regenAt){
    h.count = Math.min(5, h.count + 1);
    h.regenAt = Date.now() + 30*60*1000;
    localStorage.setItem('bellaHearts', JSON.stringify(h));
  }
  return h;
}
function useHeart(){
  const h = getHearts();
  h.count = Math.max(0, h.count - 1);
  if(h.count < 5 && !h.regenAt) h.regenAt = Date.now() + 30*60*1000;
  localStorage.setItem('bellaHearts', JSON.stringify(h));
  renderHearts();
}
function renderHearts(){
  const h = getHearts();
  const el = document.getElementById('heartsDisplay');
  if(!el) return;
  el.innerHTML = '';
  for(let i=0;i<5;i++){
    const s = document.createElement('span');
    s.className = 'heart' + (i >= h.count ? ' lost' : '');
    s.textContent = i < h.count ? '❤️' : '🖤';
    el.appendChild(s);
  }
}

// ═══════════════════════════════════════
// STREAK
// ═══════════════════════════════════════
function checkStreak(){
  const today = new Date().toISOString().slice(0,10);
  if(state.lastDay === today) return;
  const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0,10);
  if(state.lastDay === yesterday) state.streak++;
  else if(state.lastDay !== today) state.streak = 1;
  state.lastDay = today;
  save();
}
function checkDaily(){
  const today = new Date().toISOString().slice(0,10);
  if(state.dailyDate !== today){ state.dailyDone = 0; state.dailyDate = today; save(); }
}

// ═══════════════════════════════════════
// XP & ACHIEVEMENTS
// ═══════════════════════════════════════
function addXP(amount, x, y){
  const oldLv = getLevel(state.xp);
  state.xp += amount;
  state.dailyDone = (state.dailyDone||0) + 1;
  save();
  const newLv = getLevel(state.xp);
  if(newLv > oldLv) toast('🎉 עלית רמה! ' + LEVEL_NAMES[newLv], 'success');
  checkAchievements();
  renderXP();
  // Float animation
  const f = document.createElement('div');
  f.className = 'xp-float';
  f.textContent = '+' + amount + ' XP';
  f.style.left = (x || window.innerWidth/2) + 'px';
  f.style.top = (y || 100) + 'px';
  document.body.appendChild(f);
  setTimeout(()=>f.remove(), 1000);
}

const ACHIEVEMENTS = [
  {id:'first_word', name:'מילה ראשונה', icon:'📝', check:()=>state.wordsLearned.length>=1},
  {id:'ten_words', name:'10 מילים', icon:'📚', check:()=>state.wordsLearned.length>=10},
  {id:'fifty_words', name:'50 מילים', icon:'🎓', check:()=>state.wordsLearned.length>=50},
  {id:'hundred_words', name:'100 מילים', icon:'🏆', check:()=>state.wordsLearned.length>=100},
  {id:'streak3', name:'רצף 3 ימים', icon:'🔥', check:()=>state.streak>=3},
  {id:'streak7', name:'רצף שבוע', icon:'⚡', check:()=>state.streak>=7},
  {id:'streak30', name:'רצף חודש', icon:'🌟', check:()=>state.streak>=30},
  {id:'first_dialogue', name:'שיחה ראשונה', icon:'🗣️', check:()=>Object.keys(state.dialoguesCompleted||{}).length>=1},
  {id:'all_dialogues', name:'כל השיחות', icon:'🎭', check:()=>Object.keys(state.dialoguesCompleted||{}).length>=8},
  {id:'sentence5', name:'5 משפטים', icon:'🎤', check:()=>Object.keys(state.sentencesPracticed||{}).length>=5},
  {id:'sentence50', name:'50 משפטים', icon:'🎙️', check:()=>Object.keys(state.sentencesPracticed||{}).length>=50},
  {id:'quiz80', name:'חידון 80%+', icon:'🧠', check:()=>state.quizHistory.some(q=>q.score>=80)},
  {id:'xp500', name:'500 XP', icon:'💎', check:()=>state.xp>=500},
  {id:'xp2000', name:'2000 XP', icon:'👑', check:()=>state.xp>=2000},
];
function checkAchievements(){
  ACHIEVEMENTS.forEach(a=>{
    if(!state.achievements.includes(a.id) && a.check()){
      state.achievements.push(a.id);
      save();
      toast('🏅 הישג חדש: ' + a.name, 'success');
    }
  });
}
function renderXP(){
  const el = document.getElementById('xpBadge');
  if(el) el.textContent = state.xp + ' XP';
}

// ═══════════════════════════════════════
// SPEECH (TTS + STT)
// ═══════════════════════════════════════
function speak(text, lang='it-IT', rate){
  const u = new SpeechSynthesisUtterance(text);
  u.lang = lang;
  u.rate = rate || state.speechRate || 0.8;
  u.pitch = 1;
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}
function startListening(lang, callback){
  if(!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)){
    toast('🎤 הדפדפן לא תומך בזיהוי דיבור', 'error');
    return;
  }
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  recognition = new SR();
  recognition.lang = lang;
  recognition.interimResults = false;
  recognition.maxAlternatives = 3;
  recognition.onresult = (e) => {
    const results = [];
    for(let i=0;i<e.results[0].length;i++) results.push(e.results[0][i].transcript);
    callback(results);
  };
  recognition.onerror = (e) => {
    isListening = false;
    if(e.error !== 'no-speech') toast('שגיאה: ' + e.error, 'error');
    callback(null);
  };
  recognition.onend = () => { isListening = false; };
  isListening = true;
  recognition.start();
}
function stopListening(){
  if(recognition){ recognition.stop(); isListening = false; }
}
function fuzzyMatch(a, b){
  if(!a || !b) return 0;
  const norm = s => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^\w\s]/g,'').replace(/\s+/g,' ').trim();
  const wa = norm(a).split(' '), wb = norm(b).split(' ');
  let matched = 0;
  wb.forEach(w => { if(wa.some(a => a.includes(w) || w.includes(a))) matched++; });
  return Math.max(0, Math.min(100, Math.round(matched / Math.max(wa.length, wb.length) * 100)));
}

// ═══════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════
function goPage(p){
  document.querySelectorAll('.page').forEach(el=>el.classList.remove('active'));
  document.getElementById('page-'+p).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(a=>a.classList.toggle('active',a.dataset.page===p));
  stopListening();
  if(p==='home') renderHome();
  if(p==='learn') renderLearn();
  if(p==='practice') renderPractice();
  if(p==='dialogues') renderDialogues();
  if(p==='profile') renderProfile();
  window.scrollTo(0,0);
}
function toast(msg, type=''){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show ' + type;
  setTimeout(()=>t.className='toast', 2500);
}

