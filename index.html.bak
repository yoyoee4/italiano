<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0a0e17">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description" content="VolaLingo — למד איטלקית! 10,000 מילים, A1-C2, כרטיסיות, תרגול, הקראה">
<meta name="keywords" content="learn Italian, Italian language app, Italian vocabulary, למידת איטלקית, אפליקציה איטלקית">
<link rel="canonical" href="https://italiano.tickerio.app/">
<meta property="og:type" content="website">
<meta property="og:title" content="VolaLingo — למד איטלקית 🇮🇹">
<meta property="og:description" content="10,000 מילים! מסלול A1→C2, כרטיסיות, תרגול, הקראה וסימולציות.">
<meta property="og:image" content="https://italiano.tickerio.app/icon-512.png">
<meta property="og:url" content="https://italiano.tickerio.app/">
<title>VolaLingo v3 — למד איטלקית 🇮🇹</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/png" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;600;700;800;900&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/v3.css">
</head>
<body>

<!-- ═══ SPLASH ═══ -->
<div id="splash" style="position:fixed;inset:0;z-index:9999;background:var(--bg);display:flex;align-items:center;justify-content:center;transition:opacity .4s">
  <div style="text-align:center">
    <div style="font-size:4rem;animation:pulse 1.5s infinite">🇮🇹</div>
    <div style="font-family:var(--font-it);font-size:2.4rem;font-weight:900;letter-spacing:-2px;color:var(--text);margin-top:8px">Vola<span style="color:var(--accent)">Lingo</span></div>
    <div style="color:var(--text3);font-size:.85rem;margin-top:4px">ללמוד איטלקית — 10,000 מילים!</div>
    <div style="width:60%;height:3px;background:var(--surface);border-radius:2px;margin:20px auto 0;overflow:hidden">
      <div id="splashBar" style="width:0%;height:100%;background:var(--accent);border-radius:2px;transition:width 1.2s ease"></div>
    </div>
  </div>
</div>

<!-- ═══ ONBOARDING ═══ -->
<div id="onboarding" style="display:none;position:fixed;inset:0;z-index:9000;background:var(--bg)">
  <div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem">
    <div style="font-size:3.5rem;margin-bottom:16px">🇮🇹</div>
    <div style="font-family:var(--font-it);font-size:2rem;font-weight:900;color:var(--text)">Vola<span style="color:var(--accent)">Lingo</span></div>
    <div style="color:var(--text3);font-size:.9rem;margin:8px 0 24px">ללמוד איטלקית כמו אפליקציה!</div>
    <input id="onbName" type="text" placeholder="השם שלך" style="width:100%;max-width:280px;padding:14px 18px;border-radius:12px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-family:var(--font-he);font-size:1rem;text-align:center;outline:none;margin-bottom:12px" dir="rtl">
    <div style="color:var(--text2);font-size:.85rem;margin-bottom:8px">רמת התחלה:</div>
    <div id="onbLevels" style="display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap;justify-content:center">
      <button onclick="selectOnbLevel('A1')" class="onb-lvl active" data-level="A1">A1</button>
      <button onclick="selectOnbLevel('A2')" class="onb-lvl" data-level="A2">A2</button>
      <button onclick="selectOnbLevel('B1')" class="onb-lvl" data-level="B1">B1</button>
      <button onclick="selectOnbLevel('B2')" class="onb-lvl" data-level="B2">B2</button>
      <button onclick="selectOnbLevel('C1')" class="onb-lvl" data-level="C1">C1</button>
      <button onclick="selectOnbLevel('C2')" class="onb-lvl" data-level="C2">C2</button>
    </div>
    <button onclick="finishOnboarding()" style="width:100%;max-width:280px;padding:14px;border-radius:12px;background:var(--accent);color:#fff;font-weight:700;font-size:1.05rem;border:none;cursor:pointer;font-family:var(--font-he)">בוא נתחיל! 🚀</button>
  </div>
</div>

<!-- ═══ PAYWALL MODAL ═══ -->
<div id="paywallModal" class="modal-overlay" style="display:none">
  <div class="modal-card">
    <button onclick="closePaywall()" class="modal-close">✕</button>
    <div style="text-align:center;margin-bottom:20px">
      <div style="font-size:2.5rem">👑</div>
      <div style="font-size:1.3rem;font-weight:800;color:var(--text)">VolaLingo Premium</div>
      <div style="color:var(--text3);font-size:.85rem;margin-top:6px">גישה לכל 10,000 המילים!</div>
    </div>
    <div style="background:var(--surface);border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span>✅</span><span style="color:var(--text2)">10,000 מילים במקום 50</span></div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span>✅</span><span style="color:var(--text2)">כל השלבים A1 עד C2</span></div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span>✅</span><span style="color:var(--text2)">סימולציות חיי יומיום</span></div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span>✅</span><span style="color:var(--text2)">חזרה מרווחת מתקדמת</span></div>
      <div style="display:flex;align-items:center;gap:8px"><span>✅</span><span style="color:var(--text2)">ללא פרסומות</span></div>
    </div>
    <div style="text-align:center;margin-bottom:16px">
      <span style="font-size:2rem;font-weight:900;color:var(--accent)">₪29</span>
      <span style="color:var(--text3);font-size:.85rem">/חודש</span>
    </div>
    <a href="https://paypal.me/smartibuy/29" target="_blank" style="display:block;width:100%;padding:14px;border-radius:12px;background:var(--accent);color:#fff;font-weight:700;font-size:1.05rem;text-align:center;text-decoration:none;font-family:var(--font-he)">שדרג עכשיו 💎</a>
    <div style="color:var(--text3);font-size:.75rem;text-align:center;margin-top:10px">אחרי התשלום, הזן: <code style="color:var(--accent)">?activate=premium</code></div>
  </div>
</div>

<!-- ═══ MAIN APP ═══ -->
<div id="app" style="display:none;height:100vh;overflow:hidden">

  <!-- SIDEBAR -->
  <aside id="sidebar" class="sidebar">
    <div class="sidebar-header">
      <div style="font-family:var(--font-it);font-size:1.4rem;font-weight:900;color:var(--text)">Vola<span style="color:var(--accent)">Lingo</span></div>
      <button onclick="toggleSidebar()" class="sidebar-close" id="sidebarCloseBtn">✕</button>
    </div>
    <div class="sidebar-user">
      <div class="avatar" id="sidebarAvatar">🇮🇹</div>
      <div>
        <div id="sidebarName" style="font-weight:700;color:var(--text)">Studente</div>
        <div id="sidebarLevel" style="font-size:.8rem;color:var(--text3)">A1</div>
      </div>
    </div>
    <div class="sidebar-stats">
      <div class="stat-pill">🔥 <span id="sideStreak">0</span></div>
      <div class="stat-pill">⚡ <span id="sideXP">0</span> XP</div>
      <div class="stat-pill" id="premiumBadge" style="display:none">👑 Premium</div>
    </div>
    <nav class="sidebar-nav">
      <button class="nav-item active" onclick="navigate('tree')" data-page="tree">
        <span class="nav-icon">🗺️</span><span class="nav-label">מסלול</span>
      </button>
      <button class="nav-item" onclick="navigate('learn')" data-page="learn">
        <span class="nav-icon">🃏</span><span class="nav-label">כרטיסיות</span>
      </button>
      <button class="nav-item" onclick="navigate('practice')" data-page="practice">
        <span class="nav-icon">🎯</span><span class="nav-label">תרגול</span>
      </button>
      <button class="nav-item" onclick="navigate('speak')" data-page="speak">
        <span class="nav-icon">🎙️</span><span class="nav-label">הקראה</span>
      </button>
      <button class="nav-item" onclick="navigate('simulate')" data-page="simulate">
        <span class="nav-icon">💬</span><span class="nav-label">סימולציה</span>
      </button>
      <button class="nav-item" onclick="navigate('srs')" data-page="srs">
        <span class="nav-icon">🧠</span><span class="nav-label">חזרה מרווחת</span>
      </button>
      <button class="nav-item" onclick="navigate('stats')" data-page="stats">
        <span class="nav-icon">📊</span><span class="nav-label">סטטיסטיקות</span>
      </button>
    </nav>
    <div class="sidebar-footer">
      <button onclick="showPaywall()" class="premium-btn" id="sidebarPremiumBtn">👑 שדרג ל-Premium</button>
      <div style="font-size:.7rem;color:var(--text3);text-align:center;margin-top:6px">v3.0 — 10,000 מילים</div>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main id="mainContent" class="main-content">
    <!-- TOP BAR -->
    <header class="topbar">
      <button onclick="toggleSidebar()" class="hamburger" id="hamburgerBtn">☰</button>
      <div class="topbar-title" id="pageTitle">מסלול</div>
      <div class="topbar-stats">
        <span class="top-stat">🔥 <span id="topStreak">0</span></span>
        <span class="top-stat">⚡ <span id="topXP">0</span></span>
      </div>
    </header>

    <!-- SCROLLABLE CONTENT AREA -->
    <div id="pageContainer" class="page-container">
      <!-- Pages rendered dynamically -->
    </div>
  </main>
</div>

<!-- ═══ TOAST ═══ -->
<div id="toast" class="toast" style="display:none"></div>

<!-- ═══ CONFETTI CANVAS ═══ -->
<canvas id="confetti" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:99999"></canvas>

<script src="js/data_v3.js"></script>
<script src="js/v3.js"></script>
</body>
</html>
