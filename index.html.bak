    <div class="stat-box"><div class="stat-val">${state.wordsLearned.length}</div><div class="stat-label">מילים</div></div>
    <div class="stat-box"><div class="stat-val">🔥 ${state.streak}</div><div class="stat-label">רצף</div></div>
    <div class="stat-box"><div class="stat-val">${Object.keys(state.sentencesPracticed||{}).length}</div><div class="stat-label">משפטים</div></div>
  `;

  document.getElementById('homeLevelBar').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <span class="level-badge">${getLevelName(state.xp)}</span>
      <span style="font-size:12px;color:var(--text2)">${state.xp}/${XP_LEVELS[lv+1]||'∞'} XP</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width:${prog}%"></div></div>
  `;

  const cat = state.lastCategory || 'ברכות';
  const catWords = APP_DATA.words.filter(w=>w.cat===cat);
  document.getElementById('homeContinue').innerHTML = `
    <div class="card" style="cursor:pointer" onclick="goPage('learn');setTimeout(()=>openCat('${cat}'),100)">
      <div class="card-title">📖 המשך ללמוד</div>
      <div class="card-desc">קטגוריה: ${cat} — ${catWords.length} מילים</div>
      <button class="btn btn-primary btn-block" style="margin-top:12px">בואו נתחיל! →</button>
    </div>
  `;

  document.getElementById('homeAnkiDue').innerHTML = ankiDue > 0 ? `
    <div class="card" style="cursor:pointer;border-color:var(--accent)" onclick="goPage('practice');setTimeout(startAnki,200)">
      <div class="card-title">🧠 חזרות Anki</div>
      <div class="card-desc">${ankiDue} כרטיסים מחכים לחזרה!</div>
      <button class="btn btn-primary btn-block" style="margin-top:12px">התחל חזרות 🔄</button>
    </div>
  ` : `
    <div class="card" style="border-color:var(--success)">
      <div class="card-title">✅ חזרות Anki</div>
      <div class="card-desc">אין כרטיסים מחכים — מעולה!</div>
    </div>
  `;

  const dailyPct = Math.min(100, Math.round((state.dailyDone||0)/state.dailyGoal*100));
  document.getElementById('homeDailyGoal').innerHTML = `
    <div class="card">
      <div class="card-title">🎯 יעד יומי</div>
      <div class="card-desc">${state.dailyDone||0}/${state.dailyGoal} פעילויות היום</div>
      <div class="progress-bar"><div class="progress-fill" style="width:${dailyPct}%"></div></div>
    </div>
  `;
}

// ═══════════════════════════════════════
// LEARN PAGE
// ═══════════════════════════════════════
let learnView = 'cats'; // 'cats' | 'words'
let learnCat = '';
function renderLearn(){
  if(learnView === 'words') renderWordList();
  else renderCatGrid();
}
function renderCatGrid(){
  const cats = {};
  APP_DATA.words.forEach(w=>{ cats[w.cat] = (cats[w.cat]||0)+1; });
  const el = document.getElementById('learnContent');
  el.innerHTML = `<h2 class="section-title">📖 קטגוריות</h2><div class="cat-grid" id="catGrid"></div>`;
  const grid = document.getElementById('catGrid');
  const icons = {'ברכות':'👋','אוכל':'🍕','פעלים':'🏃','זמן':'⏰','מספרים':'🔢','טיולים':'✈️','מקצועות':'💼','ערים איטליה':'🏙️','בית':'🏠','עבודה':'💼','תכונות':'🎭','מקומות':'📍','טבע':'🌿','אומנות':'🎨','תרבות איטלקית':'🏛️','גוף':'🦴','בגדים':'👔','רגשות':'😊','טכנולוגיה':'💻','בריאות':'💊','חינוך':'📚','מטבח איטלקי':'👨‍🍳','עסקים':'📊','משפחה':'👨‍👩‍👧','ספורט':'⚽','סלנג':'😎','חגים':'🎄','דקדוק':'✏️','צבעים':'🌈','משפטים':'💬'};
  Object.entries(cats).forEach(([cat,count])=>{
    const learned = APP_DATA.words.filter(w=>w.cat===cat && state.wordsLearned.includes(w.it)).length;
    grid.innerHTML += `<div class="cat-item" onclick="openCat('${cat}')">
      <div class="cat-icon">${icons[cat]||'📝'}</div>
      <div class="cat-name">${cat}</div>
      <div class="cat-count">${learned}/${count}</div>
    </div>`;
  });
}
function openCat(cat){
  learnCat = cat; learnView = 'words'; state.lastCategory = cat; save();
  renderWordList();
}
function renderWordList(){
  const words = APP_DATA.words.filter(w=>w.cat===learnCat);
  const el = document.getElementById('learnContent');
  el.innerHTML = `
    <button class="back-btn" onclick="learnView='cats';renderLearn()">→ חזרה לקטגוריות</button>
    <h2 class="section-title">${learnCat} <span style="font-size:13px;color:var(--text2)">(${words.length})</span></h2>
    <div id="wordList"></div>
  `;
  const list = document.getElementById('wordList');
  words.forEach(w=>{
    const learned = state.wordsLearned.includes(w.it);
    list.innerHTML += `<div class="word-item">
      <div class="word-left">
        <div class="word-it">${w.it}</div>
        <div class="word-he">${w.he}</div>
      </div>
      <div class="word-right">
        ${learned ? '<span class="learned-badge">✓</span>' : ''}
        <button class="speak-btn" onclick="speak('${w.it.replace(/'/g,"\\'")}')">🔊</button>
      </div>
    </div>`;
  });
}

