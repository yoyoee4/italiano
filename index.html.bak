      <div class="card-desc">${phrases.length} משפטי שיחה — שמע, חזור, קבל ציון!<br>${Object.keys(state.sentencesPracticed||{}).length}/${phrases.length} תורגלו</div>
      <button class="btn btn-secondary btn-block" style="margin-top:12px">התחל תרגול 🎙️</button>
    </div>
