// ═══════════════════════════════════════
// QUIZ
// ═══════════════════════════════════════
function startQuiz(type){
  quiz.type = type; quiz.current = 0; quiz.score = 0; quiz.combo = 0;
  const pool = [...APP_DATA.words].sort(()=>Math.random()-.5);
  quiz.questions = pool.slice(0,10).map(w=>{
    const wrongs = pool.filter(x=>x.it!==w.it).sort(()=>Math.random()-.5).slice(0,3);
    return {word:w, options:[w,...wrongs].sort(()=>Math.random()-.5), answered:false, correct:false};
  });
  practiceMode = 'quiz';
  renderQuizPlay();
}
function renderQuizPlay(){
  if(quiz.current >= quiz.questions.length){ renderQuizResult(); return; }
  const q = quiz.questions[quiz.current];
  const isItToHe = quiz.type==='it-he' || (quiz.type==='mixed' && Math.random()>.5);
  const hearts = getHearts();
  const comboText = quiz.combo > 1 ? `<div class="combo-display">🔥 x${quiz.combo} <span class="combo-x">קומבו!</span></div>` : '';
  
  document.getElementById('practiceContent').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <span style="font-size:13px;color:var(--text2)">שאלה ${quiz.current+1}/10</span>
      <span style="font-size:13px;color:var(--accent)">${quiz.score} נקודות</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width:${quiz.current*10}%"></div></div>
    ${comboText}
    <div class="card" style="text-align:center;margin:16px 0">
      <div style="font-size:14px;color:var(--text2);margin-bottom:8px">${isItToHe?'🇮🇹 → 🇮🇱':'🇮🇱 → 🇮🇹'}</div>
      <div style="font-size:24px;font-weight:700">${isItToHe ? q.word.it : q.word.he}</div>
      <button class="speak-btn" style="margin:12px auto" onclick="speak('${q.word.it.replace(/'/g,"\\'")}')">🔊</button>
    </div>
    <div id="quizOptions">
      ${q.options.map(o=>`<div class="quiz-option" onclick="answerQuiz(this,'${(isItToHe?o.he:o.it).replace(/'/g,"\\'")}','${(isItToHe?q.word.he:q.word.it).replace(/'/g,"\\'")}',${isItToHe},${quiz.current})">${isItToHe?o.he:o.it}</div>`).join('')}
    </div>
    <div style="text-align:center;margin-top:8px">${'❤️'.repeat(hearts.count)}${'🖤'.repeat(5-hearts.count)}</div>
  `;
}
function answerQuiz(el, chosen, correct, isItToHe, qi){
  const q = quiz.questions[qi];
  if(q.answered) return;
  q.answered = true;
  const isCorrect = chosen === correct;
  if(isCorrect){
    q.correct = true;
    quiz.combo++;
    const multiplier = Math.min(4, quiz.combo);
    const points = 10 * multiplier;
    quiz.score += points;
    state.score += points;
    addXP(points);
    el.classList.add('correct');
    // Mark word learned
    if(!state.wordsLearned.includes(q.word.it)){ state.wordsLearned.push(q.word.it); save(); }
  } else {
    quiz.combo = 0;
    el.classList.add('wrong');
    useHeart();
    // Show correct answer
    el.parentElement.querySelectorAll('.quiz-option').forEach(o=>{
      if(o.textContent.trim() === correct) o.classList.add('reveal');
    });
  }
  el.parentElement.querySelectorAll('.quiz-option').forEach(o=>o.classList.add('disabled'));
  setTimeout(()=>{ quiz.current++; renderQuizPlay(); }, 1200);
}
function renderQuizResult(){
  const pct = Math.round(quiz.score / 100 * 100);
  const stars = pct >= 90 ? 3 : pct >= 70 ? 2 : pct >= 50 ? 1 : 0;
  const emoji = pct >= 80 ? '🎉' : pct >= 60 ? '👍' : pct >= 40 ? '🤔' : '💪';
  const title = pct >= 80 ? 'Bravissimo!' : pct >= 60 ? 'Buono!' : pct >= 40 ? 'Non male!' : 'Continua!';
  state.quizHistory.push({date:new Date().toISOString().slice(0,10), score:pct});
  save();
  
  document.getElementById('practiceContent').innerHTML = `
    <div style="text-align:center;padding:20px">
      <div style="font-size:64px;margin:16px 0">${emoji}</div>
      <h2 style="font-size:28px;margin:8px 0">${title}</h2>
      <div style="font-size:20px;color:var(--accent);margin:8px 0">${quiz.score} נקודות</div>
      <div style="font-size:32px;margin:12px 0">${'⭐'.repeat(stars)}${'☆'.repeat(3-stars)}</div>
      <div class="progress-bar" style="max-width:200px;margin:12px auto"><div class="progress-fill" style="width:${pct}%"></div></div>
      <div style="font-size:13px;color:var(--text2)">${pct}% דיוק</div>
      <button class="btn btn-primary btn-block" style="margin-top:20px" onclick="startQuiz('mixed')">🔄 עוד חידון</button>
      <button class="btn btn-secondary btn-block" style="margin-top:8px" onclick="practiceMode='menu';renderPractice()">חזרה לתרגול</button>
    </div>
  `;
  practiceMode = 'menu';
}

// ═══════════════════════════════════════
// ANKI SRS
// ═══════════════════════════════════════
const ANKI_INTERVALS = [60000, 600000, 3600000, 86400000, 259200000, 604800000, 1209600000, 2592000000, 7776000000]; // 1m,10m,1h,1d,3d,7d,14d,30d,90d

function getAnkiDueCount(){
  const now = Date.now();
  return Object.values(anki).filter(a => a.nextReview <= now).length;
}
function buildAnkiQueue(){
  const now = Date.now();
  const allItems = [];
  // Mix words and phrases
  APP_DATA.words.forEach(w=>{
    const key = 'w:'+w.it;
    if(anki[key] && anki[key].nextReview <= now){
      allItems.push({type:'word', data:w, key});
    }
  });
  (APP_DATA.conversationPhrases||[]).forEach(p=>{
    const key = 'p:'+p.it;
    if(anki[key] && anki[key].nextReview <= now){
      allItems.push({type:'phrase', data:p, key});
    }
  });
  // Also add new cards (not yet in anki) — limit 5 new per session
  let newCount = 0;
  APP_DATA.words.filter(w=>!anki['w:'+w.it]).slice(0,5).forEach(w=>{
    allItems.push({type:'word', data:w, key:'w:'+w.it, isNew:true});
  });
  return allItems.sort(()=>Math.random()-.5);
}
function startAnki(){
  ankiQueue = buildAnkiQueue();
  if(ankiQueue.length === 0){
    practiceMode = 'menu'; renderPractice();
    toast('✅ אין חזרות כרגע!', 'success');
    return;
  }
  currentAnki = 0;
  practiceMode = 'anki';
  renderAnki();
}
function renderAnki(){
  if(currentAnki >= ankiQueue.length){
    document.getElementById('practiceContent').innerHTML = `
      <div class="empty-state">
        <div class="empty-icon">🎉</div>
        <div class="empty-text">סיימת את כל החזרות!</div>
        <div class="empty-sub">חזור מאוחר יותר לעוד כרטיסים</div>
        <button class="btn btn-primary" style="margin-top:16px" onclick="practiceMode='menu';renderPractice()">חזרה</button>
      </div>`;
    practiceMode = 'menu'; return;
  }
  const item = ankiQueue[currentAnki];
  const a = anki[item.key] || {interval:0, ease:2.5, reps:0};
  const showBack = item.revealed;
  
  let backHTML = '';
  if(showBack){
    const intervals = getNextIntervals(a);
    backHTML = `
      <div class="anki-back" style="opacity:1;transform:none">${item.data.he}</div>
      <button class="speak-btn" style="margin:12px auto" onclick="speak('${item.data.it.replace(/'/g,"\\'")}')">🔊</button>
      <div class="anki-buttons">
        <button class="anki-btn anki-btn-forgot" onclick="ankiRate('forgot')">🔴<br>שכחתי<br><span class="anki-btn-time">${fmtInterval(60000)}</span></button>
        <button class="anki-btn anki-btn-hard" onclick="ankiRate('hard')">🟠<br>קשה<br><span class="anki-btn-time">${fmtInterval(intervals.hard)}</span></button>
        <button class="anki-btn anki-btn-good" onclick="ankiRate('good')">🟢<br>טוב<br><span class="anki-btn-time">${fmtInterval(intervals.good)}</span></button>
        <button class="anki-btn anki-btn-easy" onclick="ankiRate('easy')">🔵<br>קל<br><span class="anki-btn-time">${fmtInterval(intervals.easy)}</span></button>
      </div>
    `;
  } else {
    backHTML = `<div style="color:var(--text2);margin-top:24px;font-size:14px">לחץ לחשוף תרגום</div>`;
  }
  
  document.getElementById('practiceContent').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <button class="back-btn" onclick="practiceMode='menu';renderPractice()">→ חזרה</button>
      <span style="font-size:13px;color:var(--text2)">${currentAnki+1}/${ankiQueue.length}</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width:${(currentAnki/ankiQueue.length)*100}%"></div></div>
    <div class="anki-card ${showBack?'revealed':''}" onclick="revealAnki()">
      <span class="anki-cat">${item.type==='phrase'?'💬 משפט':'📝 מילה'} • ${item.data.cat||''}</span>
      <div class="anki-front">${item.data.it}</div>
      ${backHTML}
    </div>
  `;
  // Auto-speak
  if(!showBack) setTimeout(()=>speak(item.data.it), 300);
}
function revealAnki(){
  const item = ankiQueue[currentAnki];
  if(!item.revealed){ item.revealed = true; renderAnki(); }
}
function getNextIntervals(a){
  const cur = a.interval || 0;
  let idx = ANKI_INTERVALS.findIndex(i => i > cur);
  if(idx === -1) idx = ANKI_INTERVALS.length - 1;
  return {
    hard: ANKI_INTERVALS[Math.max(0, idx)],
    good: ANKI_INTERVALS[Math.min(ANKI_INTERVALS.length-1, idx+1)],
    easy: ANKI_INTERVALS[Math.min(ANKI_INTERVALS.length-1, idx+2)]
  };
}
function ankiRate(rating){
  const item = ankiQueue[currentAnki];
  let a = anki[item.key] || {nextReview:0, interval:0, ease:2.5, reps:0, lastReview:0};
  const intervals = getNextIntervals(a);
  const cur = a.interval || 0;
  let idx = ANKI_INTERVALS.findIndex(i => i > cur);
  if(idx === -1) idx = ANKI_INTERVALS.length - 1;
  
  switch(rating){
    case 'forgot': a.interval = 0; a.ease = Math.max(1.3, a.ease - 0.2); a.reps = 0; break;
    case 'hard': a.interval = intervals.hard; a.ease = Math.max(1.3, a.ease - 0.15); a.reps++; break;
    case 'good': a.interval = intervals.good; a.ease += 0; a.reps++; break;
    case 'easy': a.interval = intervals.easy; a.ease += 0.15; a.reps++; break;
  }
  a.nextReview = Date.now() + a.interval;
  a.lastReview = Date.now();
  anki[item.key] = a;
  saveAnki();
  
  const xp = rating==='forgot' ? 2 : rating==='hard' ? 5 : rating==='good' ? 10 : 15;
  addXP(xp);
  
  if(rating !== 'forgot' && !state.wordsLearned.includes(item.data.it)){
    state.wordsLearned.push(item.data.it); save();
  }
  
  currentAnki++;
  renderAnki();
}
function fmtInterval(ms){
  if(ms < 60000) return '1 דק\'';
  if(ms < 3600000) return Math.round(ms/60000) + ' דק\'';
  if(ms < 86400000) return Math.round(ms/3600000) + ' שע\'';
  return Math.round(ms/86400000) + ' ימ\'';
}

// ═══════════════════════════════════════
// SENTENCE PRACTICE
// ═══════════════════════════════════════
let sentenceQueue = [], sentenceIdx = 0;
function startSentences(cat){
  const phrases = APP_DATA.conversationPhrases || [];
  sentenceQueue = cat ? phrases.filter(p=>p.cat===cat) : [...phrases].sort(()=>Math.random()-.5);
  if(sentenceQueue.length === 0){ toast('אין משפטים בקטגוריה זו','error'); return; }
  sentenceIdx = 0;
  sentenceCat = cat || null;
  practiceMode = 'sentences';
  renderSentences();
}
function renderSentences(){
  if(sentenceCat === null && sentenceIdx === 0){
    // Show category filter
    const cats = {};
    (APP_DATA.conversationPhrases||[]).forEach(p=>{ cats[p.cat] = (cats[p.cat]||0)+1; });
    document.getElementById('practiceContent').innerHTML = `
      <button class="back-btn" onclick="practiceMode='menu';renderPractice()">→ חזרה</button>
      <h2 class="section-title">🎤 משפטים לחזור עליהם</h2>
      <div class="card" style="cursor:pointer;border-color:var(--accent)" onclick="sentenceCat='all';startSentences()">
        <div class="card-title">🌍 כל המשפטים</div>
        <div class="card-desc">${APP_DATA.conversationPhrases.length} משפטים — רנדומלי</div>
      </div>
      ${Object.entries(cats).map(([cat,count])=>`
        <div class="card" style="cursor:pointer" onclick="startSentences('${cat}')">
          <div class="card-title">📂 ${cat}</div>
          <div class="card-desc">${count} משפטים</div>
        </div>
      `).join('')}
    `;
    return;
  }
  if(sentenceIdx >= sentenceQueue.length){
    document.getElementById('practiceContent').innerHTML = `
      <div class="empty-state">
        <div class="empty-icon">🎉</div>
        <div class="empty-text">סיימת את כל המשפטים!</div>
        <div class="empty-sub">${Object.keys(state.sentencesPracticed||{}).length}/${APP_DATA.conversationPhrases.length} תורגלו</div>
        <button class="btn btn-primary" style="margin-top:16px" onclick="sentenceCat=null;renderSentences()">חזרה</button>
      </div>`;
    return;
  }
  const s = sentenceQueue[sentenceIdx];
  const practiced = state.sentencesPracticed || {};
  const times = practiced[s.it] || 0;
  
  document.getElementById('practiceContent').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <button class="back-btn" onclick="sentenceCat=null;practiceMode='sentences';renderSentences()">→ חזרה</button>
      <span style="font-size:13px;color:var(--text2)">${sentenceIdx+1}/${sentenceQueue.length}</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width:${(sentenceIdx/sentenceQueue.length)*100}%"></div></div>
    <div class="sentence-card">
      <div style="font-size:11px;color:var(--text2);margin-bottom:4px">📂 ${s.cat} • ${s.context||''}</div>
      <div class="sentence-it" id="sentIt">${s.it}</div>
      <div class="sentence-he" id="sentHe" style="opacity:0;transition:opacity .3s">${s.he}</div>
      <div class="sentence-actions">
        <button class="speak-btn" style="width:48px;height:48px;font-size:22px" onclick="speak('${s.it.replace(/'/g,"\\'")}', 'it-IT', 0.6)">🐢</button>
        <button class="speak-btn" style="width:48px;height:48px;font-size:22px" onclick="speak('${s.it.replace(/'/g,"\\'")}')">🔊</button>
        <button class="mic-btn" id="sentMic" onclick="recordSentence()">🎤</button>
      </div>
      <button class="btn btn-sm btn-secondary" onclick="document.getElementById('sentHe').style.opacity=1" style="margin-top:8px">👁️ הצג תרגום</button>
      <div id="sentResult"></div>
      <div id="sentHeard"></div>
    </div>
    <div style="font-size:12px;color:var(--text2);text-align:center">תורגל ${times} פעמים</div>
  `;
  setTimeout(()=>speak(s.it), 500);
}
function recordSentence(){
  if(isListening){ stopListening(); document.getElementById('sentMic').classList.remove('listening'); return; }
  document.getElementById('sentMic').classList.add('listening');
  startListening('it-IT', (results)=>{
    document.getElementById('sentMic').classList.remove('listening');
    if(!results) return;
    const target = sentenceQueue[sentenceIdx].it;
    const bestMatch = results.reduce((best, r) => {
      const score = fuzzyMatch(r, target);
      return score > best.score ? {text:r, score} : best;
    }, {text:'', score:0});
    
    const pct = bestMatch.score;
    const cls = pct>=90?'result-perfect':pct>=70?'result-good':pct>=50?'result-ok':'result-retry';
    const label = pct>=90?'✅ מושלם!':pct>=70?'🟢 טוב!':pct>=50?'🟡 לא רע':'🔴 נסה שוב';
    
    document.getElementById('sentResult').innerHTML = `<div class="sentence-result ${cls}">${label} (${pct}%)</div>`;
    document.getElementById('sentHeard').innerHTML = `<div class="sentence-heard">🎤 שמעתי: "${bestMatch.text}"</div>`;
    document.getElementById('sentHe').style.opacity = '1';
    
    if(pct >= 50){
      const xp = pct >= 90 ? 20 : pct >= 70 ? 15 : 10;
      addXP(xp);
      const s = sentenceQueue[sentenceIdx];
      if(!state.sentencesPracticed[s.it]) state.sentencesPracticed[s.it] = 0;
      state.sentencesPracticed[s.it]++;
      save();
      // Also add to Anki for spaced review
      const key = 'p:'+s.it;
      if(!anki[key]) anki[key] = {nextReview: Date.now()+600000, interval:600000, ease:2.5, reps:1, lastReview:Date.now()};
      saveAnki();
    }
    
    if(pct >= 70){
      setTimeout(()=>{ sentenceIdx++; renderSentences(); }, 1500);
    }
  });
}

// ═══════════════════════════════════════
// DIALOGUES
// ═══════════════════════════════════════
function renderDialogues(){
  if(currentDialogue !== null){ renderDialoguePlay(); return; }
  const dialogues = APP_DATA.dialogues || [];
  document.getElementById('dialoguesContent').innerHTML = `
    <h2 class="section-title">🗣️ שיחות אינטראקטיביות</h2>
    ${dialogues.map(d=>{
      const completed = (state.dialoguesCompleted||{})[d.id];
      return `<div class="dialogue-card" onclick="openDialogue('${d.id}')">
        <div class="dialogue-icon">${d.icon}</div>
        <div class="dialogue-info">
          <div class="dialogue-title">${d.title}</div>
          <div class="dialogue-desc">${d.desc}</div>
        </div>
        <span class="dialogue-level">${completed?'✅':'רמה '+d.level}</span>
      </div>`;
    }).join('')}
  `;
}
function openDialogue(id){
  currentDialogue = (APP_DATA.dialogues||[]).find(d=>d.id===id);
  dlgLine = 0; dlgScore = 0;
  renderDialoguePlay();
}
function renderDialoguePlay(){
  if(!currentDialogue) return;
  const d = currentDialogue;
  const total = d.lines.length;
  
  // Already finished?
  if(dlgLine >= total){
    const pct = Math.round(dlgScore / total * 100);
    if(!state.dialoguesCompleted) state.dialoguesCompleted = {};
    state.dialoguesCompleted[d.id] = pct;
    save();
    addXP(pct >= 80 ? 50 : pct >= 50 ? 30 : 15);
    checkAchievements();
    
    document.getElementById('dialoguesContent').innerHTML = `
      <div style="text-align:center;padding:20px">
        <div style="font-size:64px;margin:16px 0">${d.icon}</div>
        <h2 style="font-size:24px;margin:8px 0">${d.title} — הסתיים!</h2>
        <div style="font-size:20px;color:var(--accent);margin:8px 0">${dlgScore}/${total} נכון (${pct}%)</div>
        <div style="font-size:32px;margin:12px 0">${'⭐'.repeat(pct>=80?3:pct>=50?2:pct>=30?1:0)}</div>
        <button class="btn btn-primary btn-block" style="margin-top:16px" onclick="currentDialogue=null;dlgLine=0;openDialogue('${d.id}')">🔄 נסה שוב</button>
        <button class="btn btn-secondary btn-block" style="margin-top:8px" onclick="currentDialogue=null;renderDialogues()">חזרה לשיחות</button>
      </div>`;
    return;
  }
  
  const line = d.lines[dlgLine];
  const isYou = line.role === 'you';
  const progressDots = d.lines.map((_,i) => 
    `<div class="dlg-dot ${i<dlgLine?'done':''} ${i===dlgLine?'current':''}"></div>`
  ).join('');
  
  let lineHTML = '';
  // Show all previous lines
  for(let i=0; i<dlgLine; i++){
    const prev = d.lines[i];
    lineHTML += `<div class="dlg-${prev.role}">
      <div class="dlg-role">${prev.role === 'you' ? '🙋 את/ה' : getDialogueRoleEmoji(prev.role)}</div>
      <div class="dlg-text-it">${prev.it}</div>
      <div class="dlg-text-he">${prev.he}</div>
    </div>`;
  }
  
  // Current line
  if(isYou){
    lineHTML += `
      <div class="dlg-input-area">
        <div style="font-size:14px;color:var(--accent);margin-bottom:8px">🙋 התור שלך!</div>
        <div style="font-size:14px;color:var(--warning);margin-bottom:12px">💡 רמז: ${line.hint}</div>
        <button class="mic-btn" id="dlgMic" onclick="recordDialogueLine()">🎤</button>
        <div style="font-size:12px;color:var(--text2);margin-top:8px">לחץ ותגיד באיטלקית</div>
        <div id="dlgResult"></div>
        <div id="dlgHeard"></div>
      </div>`;
  } else {
    lineHTML += `
      <div class="dlg-npc">
        <div class="dlg-role">${getDialogueRoleEmoji(line.role)}</div>
        <div class="dlg-text-it">${line.it}</div>
        <div class="dlg-text-he">${line.he}</div>
      </div>
      <button class="btn btn-primary btn-block" style="margin-top:8px" onclick="dlgLine++;renderDialoguePlay()">המשך →</button>`;
    setTimeout(()=>speak(line.it), 500);
  }
  
  document.getElementById('dialoguesContent').innerHTML = `
    <button class="back-btn" onclick="currentDialogue=null;renderDialogues()">→ חזרה</button>
    <h2 class="section-title">${d.icon} ${d.title}</h2>
    <div class="dlg-progress">${progressDots}</div>
    ${lineHTML}
  `;
}
function getDialogueRoleEmoji(role){
  const map = {barista:'☕ בריסטה', waiter:'🍝 מלצר', local:'🗺️ מקומי', vendor:'🛒 מוכר', clerk:'🏨 פקיד', friend:'🗣️ חבר', pharmacist:'💊 רוקח', date:'❤️ בת/בן זוג'};
  return map[role] || role;
}
function recordDialogueLine(){
  if(isListening){ stopListening(); document.getElementById('dlgMic').classList.remove('listening'); return; }
  document.getElementById('dlgMic').classList.add('listening');
  startListening('it-IT', (results)=>{
    document.getElementById('dlgMic').classList.remove('listening');
    if(!results) return;
    const line = currentDialogue.lines[dlgLine];
    const pct = Math.max(...results.map(r=>fuzzyMatch(r, line.it)));
    
    document.getElementById('dlgHeard').innerHTML = `<div class="sentence-heard">🎤 שמעתי: "${results[0]}"</div>`;
    
    if(pct >= 50){
      document.getElementById('dlgResult').innerHTML = `<div class="sentence-result result-${pct>=90?'perfect':pct>=70?'good':'ok'}">${pct>=90?'✅ מושלם!':pct>=70?'🟢 טוב!':'🟡 לא רע'} (${pct}%)</div>`;
      dlgScore++;
      setTimeout(()=>{ dlgLine++; renderDialoguePlay(); }, 1200);
    } else {
      document.getElementById('dlgResult').innerHTML = `
        <div class="sentence-result result-retry">🔴 נסה שוב (${pct}%)</div>
        <div style="margin-top:8px;font-size:14px;color:var(--accent)">התשובה: ${line.it}</div>
        <div style="font-size:13px;color:var(--text2)">${line.he}</div>
        <button class="btn btn-sm btn-secondary" style="margin-top:8px" onclick="dlgLine++;renderDialoguePlay()">דלג →</button>
      `;
    }
  });
}

// ═══════════════════════════════════════
// PROFILE
// ═══════════════════════════════════════
function renderProfile(){
  const chars = APP_DATA.characters || [];
  const culture = APP_DATA.culture || [];
  
  document.getElementById('profileContent').innerHTML = `
    <h2 class="section-title">🧑‍🏫 בחר דמות</h2>
    <div style="display:flex;gap:8px;overflow-x:auto;padding:8px 0">
      ${chars.map(c=>`
        <div class="card" style="min-width:140px;text-align:center;cursor:pointer;${state.character===c.id?'border-color:'+c.color:''}" onclick="state.character='${c.id}';save();renderProfile();toast('✅ נבחר: ${c.name}')">
          <div style="font-size:36px">${c.emoji}</div>
          <div style="font-weight:600;margin:4px 0">${c.name}</div>
          <div style="font-size:11px;color:var(--text2)">${c.role}</div>
        </div>
      `).join('')}
    </div>
    
    <h2 class="section-title">🏅 הישגים</h2>
    <div style="display:flex;flex-wrap:wrap;gap:4px">
      ${ACHIEVEMENTS.map(a=>`
        <span class="badge ${state.achievements.includes(a.id)?'earned':''}">${a.icon} ${a.name}</span>
      `).join('')}
    </div>
    
    <h2 class="section-title">📊 סטטיסטיקות</h2>
    <div class="card">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:14px">
        <div>📝 מילים נלמדות: <strong>${state.wordsLearned.length}</strong></div>
        <div>🎤 משפטים: <strong>${Object.keys(state.sentencesPracticed||{}).length}</strong></div>
        <div>🗣️ שיחות: <strong>${Object.keys(state.dialoguesCompleted||{}).length}</strong></div>
        <div>🧠 חידונים: <strong>${state.quizHistory.length}</strong></div>
        <div>🔥 רצף: <strong>${state.streak}</strong></div>
        <div>💎 XP: <strong>${state.xp}</strong></div>
        <div>📈 רמה: <strong>${getLevelName(state.xp)}</strong></div>
        <div>🧠 כרטיסי Anki: <strong>${Object.keys(anki).length}</strong></div>
      </div>
    </div>
    
    <h2 class="section-title">🏛️ תרבות איטלקית</h2>
    ${culture.map(c=>`
      <div class="card">
        <div class="card-title">${c.icon} ${c.title}</div>
        <div class="card-desc">${c.desc}</div>
        ${c.region ? `<div style="font-size:11px;color:var(--accent);margin-top:4px">📍 ${c.region}</div>` : ''}
      </div>
    `).join('')}
    
    <h2 class="section-title">⚙️ הגדרות</h2>
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin:8px 0">
        <span>🐢 מהירות דיבור</span>
        <input type="range" min="0.5" max="1.2" step="0.1" value="${state.speechRate||0.8}" 
          onchange="state.speechRate=parseFloat(this.value);save()" style="width:120px">
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin:8px 0">
        <span>🎯 יעד יומי</span>
        <select onchange="state.dailyGoal=parseInt(this.value);save()" style="background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 8px">
          ${[5,10,15,20,30].map(n=>`<option value="${n}" ${state.dailyGoal===n?'selected':''}>${n}</option>`).join('')}
        </select>
      </div>
    </div>
    
    <button class="btn btn-danger btn-block" style="margin-top:16px" onclick="if(confirm('לאפס הכל?'))resetAll()">🔄 אפס התקדמות</button>
  `;
}
function resetAll(){
  state = {...DEFAULT_STATE};
  anki = {};
  localStorage.removeItem('bellaAnki');
  localStorage.removeItem('bellaHearts');
  save(); saveAnki();
  toast('✅ ההתקדמות אופסה!', 'success');
  goPage('home');
}

// ═══════════════════════════════════════
// INIT
// ═══════════════════════════════════════
checkStreak(); checkDaily(); renderHearts(); renderXP(); renderHome();

// Regen hearts timer
setInterval(()=>{ renderHearts(); }, 60000);
</script>
</body>