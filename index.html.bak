      <div class="card-desc">10 שאלות — איטלקית ↔ עברית<br>❤️ חיים • 🔥 קומבו • ⭐ כוכבים</div>
      <button class="btn btn-primary btn-block" style="margin-top:12px">התחל חידון 🚀</button>
    </div>
    <div class="card" style="cursor:pointer;border-color:${ankiDue>0?'var(--accent)':'var(--border)'}" onclick="startAnki()">
      <div class="card-title">🔄 חזרות Anki</div>
      <div class="card-desc">${ankiDue>0? ankiDue+' כרטיסים מחכים!' : 'אין חזרות כרגע — חזור מאוחר יותר'}</div>
      <button class="btn btn-secondary btn-block" style="margin-top:12px" ${ankiDue===0?'disabled':''}>התחל חזרות</button>
    </div>
