        "it": "Un bicchiere di vino rosso, grazie.",
        "he": "כוס יין אדום, תודה.",
        "hint": "Translate: Un bicchiere di vino rosso, grazie."
      },
      {
        "role": "cameriere",
        "it": "Subito! Buon appetito!",
        "he": "מיד! בתיאבון!",
        "hint": "Translate: Subito! Buon appetito!"
      }
