    "scenario": "cafe",
    "title": "☕ בקפה - A1 (#1)",
    "desc": "הזמנת קפה בבר איטלקי",
    "icon": "☕",
    "level": "A1",
    "lines": [
      {
        "role": "barista",
        "it": "Buongiorno! Cosa desidera?",
        "he": "בוקר טוב! מה תרצה?",
        "hint": "Translate: Buongiorno! Cosa desidera?"
      },
      {
        "role": "cliente",
        "it": "Buongiorno! Un caffè, per favore.",
        "he": "בוקר טוב! קפה אחד, בבקשה.",
        "hint": "Translate: Buongiorno! Un caffè, per favore."
      },
      {
        "role": "barista",
        "it": "Lo vuole macchiato o normale?",
        "he": "עם חלב או רגיל?",
        "hint": "Translate: Lo vuole macchiato o normale?"
      },
      {
        "role": "cliente",
        "it": "Normale, grazie. Quanto costa?",
        "he": "רגיל, תודה. כמה עולה?",
        "hint": "Translate: Normale, grazie. Quanto costa?"
      },
      {
        "role": "barista",
        "it": "Un euro. Ecco il caffè.",
        "he": "יורו אחד. הנה הקפה.",
        "hint": "Translate: Un euro. Ecco il caffè."
      },
      {
        "role": "cliente",
        "it": "Grazie mille, arrivederci!",
        "he": "תודה רבה, להתראות!",
        "hint": "Translate: Grazie mille, arrivederci!"
      },
      {
        "role": "barista",
        "it": "Arrivederci! Buona giornata!",
        "he": "להתראות! יום טוב!",
        "hint": "Translate: Arrivederci! Buona giornata!"
      }
